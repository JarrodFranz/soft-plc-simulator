      {
        "name": "FilterBackwash_SFC",
        "language": "SequentialFunctionChart",
        "description": "Automated filter backwash sequence on high turbidity",
        "st_source": "",
        "rungs": [],
        "fbd_blocks": [],
        "fbd_wires": [],
        "fbd_networks": [],
        "sfc_steps": [
          {
            "id": "bw0",
            "name": "STANDBY",
            "is_initial": true,
            "action_st": "Backwash_Valve := FALSE;\nBackwash_Pump := FALSE;"
          },
          {
            "id": "bw1",
            "name": "OPEN_BACKWASH_VALVE",
            "is_initial": false,
            "action_st": "Backwash_Valve := TRUE;\n// Allow 5s for valve to open"
          },
          {
            "id": "bw2",
            "name": "BACKWASH_PUMPING",
            "is_initial": false,
            "action_st": "Backwash_Pump := TRUE;\n// Flush filter for 30s"
          },
          {
            "id": "bw3",
            "name": "RINSE",
            "is_initial": false,
            "action_st": "Backwash_Pump := FALSE;\n// Rinse cycle 10s"
          },
          {
            "id": "bw4",
            "name": "CLOSE_BACKWASH",
            "is_initial": false,
            "action_st": "Backwash_Valve := FALSE;\n// Return to service"
          }
        ],
        "sfc_transitions": [
          {
            "id": "bt0",
            "from_step_id": "bw0",
            "to_step_id": "bw1",
            "condition_st": "Backwash_Active",
            "kind": "single",
            "to_step_ids": [],
            "from_step_ids": []
          },
          {
            "id": "bt1",
            "from_step_id": "bw1",
            "to_step_id": "bw2",
            "condition_st": "STEP_T >= 5000  (* valve open dwell *)",
            "kind": "single",
            "to_step_ids": [],
            "from_step_ids": []
          },
          {
            "id": "bt2",
            "from_step_id": "bw2",
            "to_step_id": "bw3",
            "condition_st": "Quality_OK OR STEP_T >= 30000  (* quality recovers, else 30s flush cap *)",
            "kind": "single",
            "to_step_ids": [],
            "from_step_ids": []
          },
          {
            "id": "bt3",
            "from_step_id": "bw3",
            "to_step_id": "bw4",
            "condition_st": "STEP_T >= 10000  (* rinse cycle *)",
            "kind": "single",
            "to_step_ids": [],
            "from_step_ids": []
          },
          {
            "id": "bt4",
            "from_step_id": "bw4",
            "to_step_id": "bw0",
            "condition_st": "NOT Backwash_Active",
            "kind": "single",
            "to_step_ids": [],
            "from_step_ids": []
          }
        ],
        "enabled": true
      }
